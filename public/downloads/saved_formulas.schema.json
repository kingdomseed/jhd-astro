{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicgme2e.app/schemas/saved_formulas.schema.json",
  "title": "Mythic GME 2e Saved Formulas (v1)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "formulas": {
          "type": "array",
          "items": { "$ref": "#/$defs/SavedFormula" }
        }
      },
      "required": ["formulas"]
    },
    {
      "type": "array",
      "items": { "$ref": "#/$defs/SavedFormula" }
    }
  ],
  "$defs": {
    "SavedFormula": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "formula": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "dateAdded": { "type": "string", "format": "date-time" },
        "id": { "type": "string" }
      },
      "required": ["formula"]
    }
  }
}
