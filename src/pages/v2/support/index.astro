---
import SanctuaryFooter from "../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../layouts/SanctuaryLayout.astro";

type QuickPath = {
  title: string;
  label: string;
  body: string;
  href: string;
  icon: string;
  external?: boolean;
};

type FaqEntry = {
  question: string;
  paragraphs?: string[];
  items?: string[];
};

type FaqSection = {
  title: string;
  deck: string;
  entries: FaqEntry[];
};

const discordUrl = "https://discord.gg/PEDHrhzcnk";
const supportEmail = "support@jasonholtdigital.com";
const generalEmail = "jason@jasonholtdigital.com";

const FORMSPARK_FORM_ID =
  import.meta.env.PUBLIC_FORMSPARK_FORM_ID || "BrXEDLTap";
const TURNSTILE_SITE_KEY =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAABhU6Cccio-kREUw";
const formAction = FORMSPARK_FORM_ID
  ? `https://submit-form.com/${FORMSPARK_FORM_ID}`
  : "#";

const quickPaths: QuickPath[] = [
  {
    title: "Community help",
    label: "Join Discord",
    body:
      "Fastest for quick questions, player tips, feature requests, and shared troubleshooting.",
    href: discordUrl,
    icon: "fa-brands fa-discord",
    external: true,
  },
  {
    title: "Private support",
    label: "Email support",
    body:
      "Best for purchase questions, screenshots, account details, or anything that should not be public.",
    href: `mailto:${supportEmail}`,
    icon: "fa-solid fa-envelope",
  },
  {
    title: "Self-serve guides",
    label: "Open resources",
    body:
      "Browse setup notes, custom tables, formulas, journals, and practical app guides.",
    href: "/v2/resources/",
    icon: "fa-solid fa-book-open",
  },
  {
    title: "Known changes",
    label: "Read release notes",
    body:
      "Check recent updates, known issues, and fixes before filing a bug report.",
    href: "/v2/blog/category/release-notes/",
    icon: "fa-solid fa-newspaper",
  },
];

const faqSections: FaqSection[] = [
  {
    title: "General & Platforms",
    deck: "What the app is, who builds it, and where it ships.",
    entries: [
      {
        question: "What is Mythic GME Mobile / Digital?",
        paragraphs: [
          "The officially licensed companion for Mythic Game Master Emulator 2e by Word Mill Creative. It streamlines Fate Chart and Fate Check, Random Events, Scene Checks, Meaning Tables, lists, scenes, and more offline-first on every platform we ship.",
        ],
      },
      {
        question: "Who makes it?",
        paragraphs: [
          "Built by Jason Holt, the solo developer of Jason Holt Digital under an exclusive mobile and desktop partnership with Word Mill Creative.",
        ],
      },
      {
        question: "Where can I get it?",
        items: [
          "Apple App Store: iPhone, iPad, and macOS through Universal Purchase.",
          "Google Play: Android phones and tablets.",
          "Amazon Appstore: Fire tablets.",
          "Microsoft Store: Windows 10 and 11.",
          "itch.io: Windows, macOS, and Linux DRM-free desktop builds through one purchase.",
          "Steam: planned.",
        ],
      },
      {
        question: "Is it available worldwide?",
        paragraphs: [
          "Yes. Availability and pricing vary by store and region.",
        ],
      },
      {
        question:
          "If I purchased the app on one platform, do I need to purchase it on another?",
        paragraphs: [
          "Yes. Each platform requires its own development costs and time investment. Apple App Store Universal Purchase and itch.io are the exceptions where one purchase can cover multiple supported downloads in that store.",
        ],
      },
      {
        question: "Do I need the Mythic GME 2e rulebook?",
        paragraphs: [
          "The app is a companion to the book, so the book is highly recommended and effectively required. The app implements and accelerates Mythic, but the book teaches the system, variants, examples, and alternative rules that make the tool valuable.",
        ],
      },
    ],
  },
  {
    title: "Features & Data",
    deck: "Core tools, accessibility, language support, and where your material lives.",
    entries: [
      {
        question: "Core features",
        items: [
          "Fate Chart and Fate Check with Chaos Factor.",
          "Random Events and Event Focus rolls, including independent rolls when desired.",
          "Scene Checks and Scene Adjustments as written.",
          "Meaning Tables, including official core tables and additional tables through the Expanded Features unlock.",
          "Adventure Lists for Characters, Threads, and Features integrated with events.",
          "Scenes with titles, summaries, chaos, and unlimited scene tracking.",
          "Dice Roller with common notation support and saved formulas.",
          "Logs and Journal System for tracking games and switching between adventures.",
          "Import and export for adventures, including JSON and Markdown journal exports.",
          "iCloud Sync for Apple devices, with selectable storage locations on other platforms.",
          "Mythic Magazine content and Custom Tables through the Expanded Features unlock.",
        ],
      },
      {
        question: "Accessibility",
        items: [
          "Screen reader support across major platforms.",
          "Color-blind friendly palettes for improved contrast.",
          "Large and very-large text options that scale key UI.",
          "Left-handed mode for comfortable one-hand use.",
        ],
      },
      {
        question: "Languages",
        paragraphs: [
          "The app includes the official Brazilian Portuguese localization from RetroPunk Publicacoes and unofficial translations in Italian, French, German, and Spanish.",
          "Only the Portuguese meaning and event focus tables are localized out of the box. With the custom tables editor, you can localize other language tables yourself.",
        ],
      },
    ],
  },
  {
    title: "Purchases, Pricing & Upgrades",
    deck: "Plain-English purchase rules, unlocks, and cross-platform expectations.",
    entries: [
      {
        question: "Why a new app listing?",
        paragraphs: [
          "The original developer closed their business and stopped work on the legacy app. Jason Holt Digital restarted development under a new account and rebuilt the codebase, so Apple, Google, and Amazon treat this as a new product rather than a free update to the old listing.",
        ],
      },
      {
        question: "Pricing by store",
        items: [
          "Apple App Store: base app plus a one-time Expanded Features unlock. Universal Purchase covers iOS, iPadOS, and macOS.",
          "Google Play and Amazon Appstore: base app plus a one-time Expanded Features unlock.",
          "Microsoft Store: one-time desktop purchase with no in-app purchases.",
          "itch.io: one-time DRM-free desktop purchase with supported desktop downloads.",
          "Prices convert to local currency and may vary by region, taxes, and store policy.",
        ],
      },
      {
        question: "Is this a subscription?",
        paragraphs: [
          "No. Mobile stores use a one-time Expanded Features unlock. Desktop stores are one-time purchases with no in-app purchases.",
        ],
      },
      {
        question: "How the Expanded Features unlock works",
        items: [
          "When you buy the unlock, you keep all current expanded features forever.",
          "For the next 12 months, any new expanded features added during that window are also yours permanently.",
          "After 12 months, the app continues receiving bug fixes and improvements, but brand-new expanded features may appear locked until you choose to buy a new unlock.",
          "Existing unlocked features never expire.",
        ],
      },
      {
        question: "What's included today in Expanded Features?",
        items: [
          "50+ additional Meaning Tables from Mythic Magazines and Variations.",
          "12+ extra Event Focus tables from Magazines and Variations.",
          "Custom Tables toolkit for building, linking, tagging, categorizing, importing, exporting, and modifying oracles.",
        ],
      },
      {
        question: "Planned premium additions",
        items: [
          "Progress Tracks and Keyed Scenes.",
          "Custom Lists.",
          "Hybrid Play for using real dice.",
          "Advanced journaling and note-taking.",
        ],
      },
      {
        question: "Questions about the old app vs this one?",
        paragraphs: [
          "If you have questions about your original purchase or how it relates to this new version, reach out by email or Discord. I am happy to answer questions and concerns directly.",
        ],
      },
      {
        question: "Cross-platform note",
        paragraphs: [
          "Purchases generally do not transfer between stores because each platform is separate. Apple is an exception through Universal Purchase, and itch.io provides multi-platform desktop downloads under a single purchase.",
        ],
      },
    ],
  },
  {
    title: "Getting Help",
    deck: "Bug reports, diagnostics, and what to include so the reply is useful.",
    entries: [
      {
        question: "How do I report a bug?",
        paragraphs: [
          "Use in-app feedback through Settings > Report an Issue, email support, or post in Discord bug reports. Include your platform, app version, what happened, what you expected, and any screenshots or export files that make the issue easier to reproduce.",
        ],
      },
    ],
  },
];

const messageChecklist = [
  "Platform and store: iOS, Android, Fire, Windows, macOS, Linux, itch.io, or Microsoft Store.",
  "App version and device or operating system version.",
  "What you were doing, what happened, and what you expected instead.",
  "Screenshots, export files, or exact error text when available.",
];
---

<SanctuaryLayout
  title="Support & Contact - Jason Holt Digital"
  description="Quick answers, Discord, FAQ, and direct contact options for Mythic GME Mobile and Digital."
  canonicalPath="/v2/support/"
  mainClass="sx-support-main"
>
  <Fragment slot="head">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" aria-labelledby="support-hero-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">Support desk</p>
        <h1 id="support-hero-title" class="sx-page-title">
          Get help without digging through the whole site.
        </h1>
        <p class="sx-page-lead">
          Start with the fastest route: community help for quick questions,
          email for private details, resources for guides, and the FAQ for the
          rules of the road.
        </p>
        <div class="sx-cta-row" aria-label="Primary support actions">
          <a class="sx-btn sx-btn--primary" href={`mailto:${supportEmail}`}>
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            Email support
          </a>
          <a class="sx-btn sx-btn--ghost" href="#contact-panel" data-sx-tab-open="contact">
            <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
            Contact form
          </a>
        </div>
      </div>
      <aside class="sx-card" aria-label="Support routing summary">
        <h3>Open desk</h3>
        <p><strong>Fastest reply:</strong> Discord community</p>
        <p><strong>Private issue:</strong> Email support</p>
        <p><strong>Self-serve:</strong> Resources and FAQ</p>
        <p><strong>Best bug report:</strong> Platform, version, steps, screenshots</p>
      </aside>
    </div>
  </section>

  <section class="sx-section" aria-labelledby="support-routes-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Quick paths</p>
      <h2 id="support-routes-title" class="sx-sec-title">
        Pick the route that matches the kind of help you need.
      </h2>
      <p class="sx-page-lead">
        No maze, no support theater. These are the working doors.
      </p>
      <ul class="sx-card-grid" style="margin-top:1.5rem;">
        {
          quickPaths.map((item) => (
            <li class="sx-card">
              <h3>
                <i class={item.icon} aria-hidden="true"></i> {item.title}
              </h3>
              <p>{item.body}</p>
              <p style="margin-top:0.75rem;">
                <a
                  class="sx-btn sx-btn--ghost"
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sx-section sx-section--band" aria-labelledby="support-hub-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Support hub</p>
      <h2 id="support-hub-title" class="sx-sec-title">FAQ and contact in one place.</h2>

      <div class="sx-tabs" role="tablist" aria-label="Support sections">
        <button
          class="sx-tab"
          type="button"
          role="tab"
          id="faq-tab"
          aria-selected="true"
          aria-controls="faq-panel"
          data-sx-tab="faq"
        >
          FAQ
        </button>
        <button
          class="sx-tab"
          type="button"
          role="tab"
          id="contact-tab"
          aria-selected="false"
          aria-controls="contact-panel"
          data-sx-tab="contact"
        >
          Contact
        </button>
      </div>

      <div
        id="faq-panel"
        class="sx-tab-panel"
        role="tabpanel"
        aria-labelledby="faq-tab"
        data-sx-tab-panel="faq"
      >
        <div class="sx-faq" aria-label="Support FAQ sections">
          {
            faqSections.map((section, sectionIndex) => (
              <details open={sectionIndex === 0 ? true : undefined}>
                <summary>
                  {section.title}
                  <span class="sx-list__meta" style="display:block;font-weight:500;">
                    {section.deck}
                  </span>
                </summary>
                <div>
                  {section.entries.map((entry) => (
                    <details>
                      <summary>{entry.question}</summary>
                      <div class="sx-prose">
                        {entry.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                        {entry.items && (
                          <ul>
                            {entry.items.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </details>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
        <p class="sx-page-lead" style="margin-top:1rem;">
          <small>
            Check <a href="/v2/blog/category/release-notes/">Release Notes</a> for
            recent fixes and known issues.
          </small>
        </p>
      </div>

      <div
        id="contact-panel"
        class="sx-tab-panel"
        role="tabpanel"
        aria-labelledby="contact-tab"
        data-sx-tab-panel="contact"
        hidden
      >
        <div style="display:grid;grid-template-columns:1fr 1.2fr;gap:1.5rem;align-items:start;">
          <div>
            <h3 class="sx-sec-title" style="font-size:1.35rem;">Get in touch</h3>
            <div class="sx-card" style="margin:1rem 0;">
              <h3>Email</h3>
              <p>
                <strong>Support:</strong>
                <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
              </p>
              <p>
                <strong>General:</strong>
                <a href={`mailto:${generalEmail}`}>{generalEmail}</a>
              </p>
            </div>
            <div class="sx-card" style="margin-bottom:1rem;">
              <h3>Discord</h3>
              <p>Ask questions, share feedback, and talk with other Mythic players.</p>
              <p style="margin-top:0.75rem;">
                <a
                  class="sx-btn sx-btn--accent"
                  href={discordUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <i class="fa-brands fa-discord" aria-hidden="true"></i>
                  Join Discord
                </a>
              </p>
            </div>
            <aside class="sx-card" aria-labelledby="support-brief-title">
              <h3 id="support-brief-title">Before you send a bug report</h3>
              <ul>
                {messageChecklist.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </aside>
          </div>

          <div>
            <h3 class="sx-sec-title" style="font-size:1.35rem;">Send a message</h3>
            <form
              id="contact-form"
              class="sx-form"
              style="margin-top:1rem;"
              action={formAction}
              method="post"
            >
              <label for="name">
                Name
                <input type="text" id="name" name="name" required maxlength="256" placeholder="Your name" />
              </label>
              <label for="email">
                Email
                <input type="email" id="email" name="email" required maxlength="256" placeholder="your@email.com" />
              </label>
              <label for="phone">
                Phone (optional)
                <input type="tel" id="phone" name="phone" maxlength="256" placeholder="Your phone number" />
              </label>
              <label for="message">
                Message
                <textarea
                  id="message"
                  name="message"
                  required
                  maxlength="5000"
                  rows="6"
                  placeholder="Tell me what you need help with. For app issues, include your platform and app version."
                ></textarea>
              </label>

              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-callback="onTurnstileSuccess"></div>

              <button type="submit" id="submit-btn" disabled class="sx-btn sx-btn--primary">
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                Send Message
              </button>

              <div id="form-success" hidden>
                <strong>Thank you!</strong> Your message has been sent. I'll reply as soon as I can.
              </div>
              <div id="form-error" hidden>
                <strong>Something went wrong.</strong> Please try again, or email me directly at jason@jasonholtdigital.com.
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const tabs = [...document.querySelectorAll("[data-sx-tab]")];
      const panels = [...document.querySelectorAll("[data-sx-tab-panel]")];

      const openTab = (name) => {
        tabs.forEach((tab) => {
          const selected = tab.getAttribute("data-sx-tab") === name;
          tab.setAttribute("aria-selected", selected ? "true" : "false");
        });
        panels.forEach((panel) => {
          const match = panel.getAttribute("data-sx-tab-panel") === name;
          panel.hidden = !match;
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          openTab(tab.getAttribute("data-sx-tab") || "faq");
        });
      });

      document.querySelectorAll("[data-sx-tab-open]").forEach((link) => {
        link.addEventListener("click", () => {
          openTab(link.getAttribute("data-sx-tab-open") || "contact");
        });
      });

      const syncHash = () => {
        if (window.location.hash === "#contact-panel") {
          openTab("contact");
          const panel = document.getElementById("contact-panel");
          const scroll = () => panel?.scrollIntoView({ block: "start" });
          scroll();
          window.requestAnimationFrame(scroll);
          window.setTimeout(scroll, 150);
        } else {
          openTab("faq");
        }
      };

      window.addEventListener("load", syncHash);
      window.addEventListener("hashchange", syncHash);
      syncHash();

      window.onTurnstileSuccess = function (token) {
        const submitBtn = document.getElementById("submit-btn");
        if (submitBtn) submitBtn.disabled = false;
        const form = document.getElementById("contact-form");
        if (!form) return;
        let tokenInput = document.getElementById("cf-turnstile-response");
        if (!tokenInput) {
          tokenInput = document.createElement("input");
          tokenInput.type = "hidden";
          tokenInput.name = "cf-turnstile-response";
          tokenInput.id = "cf-turnstile-response";
          form.appendChild(tokenInput);
        }
        tokenInput.value = token;
      };

      const form = document.getElementById("contact-form");
      if (!form) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (form.action.endsWith("#") || form.getAttribute("action") === "#") {
          alert(
            "Form is not configured yet (dev). Set PUBLIC_FORMSPARK_FORM_ID and PUBLIC_TURNSTILE_SITE_KEY to enable submissions.",
          );
          return false;
        }

        const submitBtn = document.getElementById("submit-btn");
        const turnstileToken = document.getElementById("cf-turnstile-response");
        const successDiv = document.getElementById("form-success");
        const errorDiv = document.getElementById("form-error");

        if (successDiv) successDiv.hidden = true;
        if (errorDiv) errorDiv.hidden = true;

        if (!turnstileToken || !turnstileToken.value) {
          alert("Please complete the security verification.");
          return false;
        }

        const savedChildren = submitBtn ? Array.from(submitBtn.childNodes) : [];
        if (submitBtn) {
          submitBtn.textContent = "";
          const spinner = document.createElement("i");
          spinner.className = "fa-solid fa-spinner fa-spin";
          spinner.setAttribute("aria-hidden", "true");
          submitBtn.appendChild(spinner);
          submitBtn.appendChild(document.createTextNode(" Sending..."));
          submitBtn.disabled = true;
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
          });

          if (response.ok) {
            if (successDiv) successDiv.hidden = false;
            form.reset();
            window.turnstile?.reset();
          } else if (errorDiv) {
            errorDiv.hidden = false;
          }
        } catch (error) {
          console.error("Form submission error:", error);
          if (errorDiv) errorDiv.hidden = false;
        } finally {
          if (submitBtn) {
            submitBtn.textContent = "";
            savedChildren.forEach((node) => submitBtn.appendChild(node));
            submitBtn.disabled = true;
          }
        }
      });
    })();
  </script>

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
