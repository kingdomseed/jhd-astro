---
import SanctuaryFooter from "../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../layouts/SanctuaryLayout.astro";
import { extractLegalArticle } from "../../../lib/v2Legal";
import termsSource from "../../terms.astro?raw";

const legalArticle = extractLegalArticle(termsSource, "terms.astro");
---

<SanctuaryLayout
  title="Terms of Service - Jason Holt Digital"
  description="Terms of Service for Mythic GME Apps: license, purchases and refunds, acceptable use, disclaimers, and limitations of liability."
  canonicalPath="/v2/terms/"
  mainClass="sx-legal-main"
>
  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" aria-labelledby="terms-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">Legal</p>
        <h1 id="terms-title" class="sx-page-title">Terms of <em>Service</em>.</h1>
        <p class="sx-page-lead">
          License terms, purchases and refunds, acceptable use, and limitations.
          Last updated: August 27, 2025.
        </p>
        <ul class="sx-proof" aria-label="Terms highlights">
          <li>Personal play license</li>
          <li>Store-managed purchases</li>
          <li>Word Mill license notice</li>
        </ul>
      </div>
      <aside class="sx-card">
        <h3>Clear terms</h3>
        <p>Fair use, official content boundaries, support expectations, and the practical legal bits in one place.</p>
      </aside>
    </div>
  </section>

  <section class="sx-article">
    <div class="sx-wrap" style="display:grid;grid-template-columns:1.4fr 0.6fr;gap:1.5rem;align-items:start;">
      <article class="sx-article__body" set:html={legalArticle} />
      <aside aria-label="Legal actions">
        <div class="sx-card" style="margin-bottom:1rem;">
          <h3>Legal questions</h3>
          <p><a href="mailto:legal@jasonholtdigital.com">legal@jasonholtdigital.com</a></p>
        </div>
        <div class="sx-card">
          <h3>Privacy</h3>
          <p><a href="/v2/privacy/">Read the Privacy Policy</a></p>
        </div>
      </aside>
    </div>
  </section>

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
