---
import type { CollectionEntry } from "astro:content";
import SanctuaryFooter from "../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../layouts/SanctuaryLayout.astro";
import { getResourcesByLang } from "../../../lib/collections";
import { formatDate } from "../../../lib/format-date";
import { v2ResourceCategoryMeta } from "../../../lib/v2ContentMeta";
import { v2DiscordUrl, v2SupportUrl } from "../../../lib/v2Links";

type ResourceEntry = CollectionEntry<"resources">;
type ResourceCategory = ResourceEntry["data"]["category"];

const entries = await getResourcesByLang("en");

const sortByOrder = (items: ResourceEntry[]) =>
  [...items].sort((a, b) =>
    a.data.order === b.data.order
      ? a.data.title.localeCompare(b.data.title)
      : a.data.order - b.data.order,
  );

const categoryMeta = v2ResourceCategoryMeta;

const guideCategories = [
  "start-here",
  "adventure-journals",
  "dice-roller",
  "custom-tables",
] satisfies ResourceCategory[];

const guideSections = guideCategories
  .map((category) => ({
    category,
    ...categoryMeta[category],
    items: sortByOrder(entries.filter((entry) => entry.data.category === category)),
  }))
  .filter((section) => section.items.length > 0);

const advancedItems = sortByOrder(
  entries.filter((entry) => entry.data.category === "advanced"),
);

const guideCount = entries.length - advancedItems.length;
const updatedEntries = entries
  .filter((entry) => entry.data.updated)
  .sort(
    (a, b) =>
      (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0),
  );
const latestUpdated = updatedEntries[0]?.data.updated;

const firstResourceByCategory = (category: ResourceCategory) =>
  sortByOrder(entries.filter((entry) => entry.data.category === category))[0];

const featuredResources: Array<{
  label: string;
  note: string;
  icon: string;
  entry: ResourceEntry;
}> = [];

const addFeaturedResource = (
  category: ResourceCategory,
  label: string,
  note: string,
  icon: string,
) => {
  const entry = firstResourceByCategory(category);
  if (entry) {
    featuredResources.push({ label, note, icon, entry });
  }
};

addFeaturedResource(
  "start-here",
  "First session",
  "Begin with the core Mythic flow.",
  "fa-solid fa-route",
);
addFeaturedResource(
  "dice-roller",
  "Dice syntax",
  "Turn formulas into saved tools.",
  "fa-solid fa-dice",
);
addFeaturedResource(
  "custom-tables",
  "Table building",
  "Shape custom oracle content.",
  "fa-solid fa-layer-group",
);

const searchEntries = sortByOrder(entries).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  summary: entry.data.summary,
  category: categoryMeta[entry.data.category].label,
  duration: entry.data.duration ?? null,
  updated: entry.data.updated ?? null,
  searchText: [
    entry.data.title,
    entry.data.summary,
    categoryMeta[entry.data.category].label,
    entry.data.duration ?? "",
    ...(entry.data.tags ?? []),
    ...(entry.data.keywords ?? []),
  ].join(" "),
}));
---

<SanctuaryLayout
  title="Resources - Jason Holt Digital"
  description="Guides and reference docs for the official Mythic GME 2e companion apps."
  canonicalPath="/v2/resources/"
  mainClass="sx-resources-main"
>
  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" id="resources" aria-labelledby="resources-hero-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">Mythic field index</p>
        <h1 id="resources-hero-title" class="sx-page-title">
          Guides for keeping solo play <em>moving</em>.
        </h1>
        <p class="sx-page-lead">
          Real support docs for the official Mythic GME apps: first-session
          setup, journals, dice formulas, custom tables, and export references.
        </p>
        <div class="sx-cta-row" aria-label="Primary resource actions">
          <a class="sx-btn sx-btn--primary" href="/v2/resources/getting-started-with-the-mythic-apps/">
            <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
            Start reading
          </a>
          <a class="sx-btn sx-btn--ghost" href="/v2/resources/#guide-index">
            <i class="fa-solid fa-map" aria-hidden="true"></i>
            Browse index
          </a>
        </div>
        <ul class="sx-proof" aria-label="Resource library highlights">
          <li><strong>{guideCount}</strong> Guides</li>
          <li><strong>{advancedItems.length}</strong> References</li>
          <li>
            <strong>{latestUpdated ? formatDate(latestUpdated) : "Current"}</strong>
            Latest update
          </li>
        </ul>
      </div>

      <aside
        class="sx-card"
        aria-label="Search resource guides"
        data-resource-search-root
      >
        <p class="sx-kicker" aria-hidden="true">Find the right page</p>
        <h2 class="sx-sec-title" style="font-size:1.35rem;">Search the field notes.</h2>
        <div class="sx-form" style="margin-top:1rem;">
          <label for="resource-search-input">
            Resource search
            <input
              id="resource-search-input"
              type="search"
              name="resource-search"
              placeholder="Search formulas, journals, tables..."
              autocomplete="off"
              aria-autocomplete="list"
              aria-controls="resource-search-dropdown"
              aria-expanded="false"
              data-resource-search-input
            />
          </label>
          <div
            id="resource-search-dropdown"
            role="listbox"
            aria-label="Resource search results"
            hidden
            data-resource-search-dropdown
            style="border:1px solid var(--sx-line);background:var(--sx-white);"
          >
            <ul role="presentation" style="list-style:none;margin:0;padding:0;">
              {
                searchEntries.map((entry, index) => (
                  <li
                    id={`resource-search-option-${index}`}
                    role="option"
                    aria-selected="false"
                    data-resource-search-item
                    data-search={entry.searchText}
                    hidden
                  >
                    <a href={`/v2/resources/${entry.id}/`} tabindex="-1" style="display:block;padding:0.75rem 1rem;color:inherit;text-decoration:none;">
                      <strong>{entry.title}</strong>
                      <span class="sx-list__meta">{entry.summary}</span>
                      <span class="sx-list__meta">
                        {entry.category}
                        {entry.duration && <> / {entry.duration}</>}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p data-resource-search-empty hidden style="padding:0.75rem 1rem;margin:0;color:var(--sx-muted);">
              No matching field notes.
            </p>
            <p
              role="status"
              aria-live="polite"
              data-resource-search-status
              style="padding:0 1rem 0.75rem;margin:0;font-size:0.8rem;color:var(--sx-muted);"
            >
            </p>
          </div>
        </div>

        {
          featuredResources.length > 0 && (
            <nav aria-label="Fast resource paths" style="margin-top:1rem;display:grid;gap:0.5rem;">
              {featuredResources.map((item) => (
                <a class="sx-btn sx-btn--ghost" href={`/v2/resources/${item.entry.id}/`}>
                  <i class={item.icon} aria-hidden="true"></i>
                  {item.label}
                </a>
              ))}
            </nav>
          )
        }
      </aside>
    </div>
  </section>

  <section class="sx-section" id="guide-index" aria-labelledby="guide-index-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Guide index</p>
      <h2 id="guide-index-title" class="sx-sec-title">
        Read by job, not by release date.
      </h2>
      <p class="sx-page-lead">
        Each shelf pulls from the live English resource collection and points to
        the full guide page.
      </p>

      {
        guideSections.map((section) => (
          <section class="sx-section" aria-labelledby={`${section.category}-title`} id={section.category}>
            <p class="sx-kicker" aria-hidden="true">
              <i class={section.icon} aria-hidden="true"></i> {section.label}
            </p>
            <h3 id={`${section.category}-title`} class="sx-sec-title">{section.title}</h3>
            <p class="sx-page-lead">{section.summary}</p>
            <ol class="sx-list" style="margin-top:1rem;">
              {section.items.map((item) => (
                <li>
                  <a href={`/v2/resources/${item.id}/`}>
                    <strong>{item.data.title}</strong>
                    <span class="sx-list__meta">{item.data.summary}</span>
                    <span class="sx-list__meta">
                      {item.data.duration && <>{item.data.duration} · </>}
                      {categoryMeta[item.data.category].shortLabel}
                      {item.data.updated && <> · Updated {formatDate(item.data.updated)}</>}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  {
    advancedItems.length > 0 && (
      <section class="sx-section sx-section--band" id="schemas" aria-labelledby="schemas-title">
        <div class="sx-wrap">
          <p class="sx-kicker" aria-hidden="true">Schema shelf</p>
          <h2 id="schemas-title" class="sx-sec-title">
            Export references for the tinkerers.
          </h2>
          <p class="sx-page-lead">
            The deep-dive pages stay close to the data shapes: formulas,
            journals, categories, and custom tables.
          </p>
          <ul class="sx-list" style="margin-top:1.25rem;">
            {advancedItems.map((item) => (
              <li>
                <a href={`/v2/resources/${item.id}/`}>
                  <strong>{item.data.title}</strong>
                  <span class="sx-list__meta">{item.data.summary}</span>
                  <span class="sx-list__meta">
                    {item.data.duration ?? categoryMeta.advanced.shortLabel}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="sx-section" aria-labelledby="resources-support-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Still stuck</p>
      <h2 id="resources-support-title" class="sx-sec-title">
        Bring the odd case to support.
      </h2>
      <p class="sx-page-lead">
        Screenshots, exports, and edge cases are easier to solve in a direct
        thread than in a generic docs page.
      </p>
      <div class="sx-cta-row" style="margin-top:1.25rem;">
        <a class="sx-btn sx-btn--primary" href={v2SupportUrl}>
          <i class="fa-solid fa-life-ring" aria-hidden="true"></i>
          Support hub
        </a>
        <a
          class="sx-btn sx-btn--ghost"
          href={v2DiscordUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-discord" aria-hidden="true"></i>
          Discord
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    const resourceSearchRoot = document.querySelector("[data-resource-search-root]");

    if (resourceSearchRoot) {
      const input = resourceSearchRoot.querySelector("[data-resource-search-input]");
      const dropdown = resourceSearchRoot.querySelector("[data-resource-search-dropdown]");
      const items = [
        ...resourceSearchRoot.querySelectorAll("[data-resource-search-item]"),
      ];
      const empty = resourceSearchRoot.querySelector("[data-resource-search-empty]");
      const status = resourceSearchRoot.querySelector("[data-resource-search-status]");
      let activeIndex = -1;

      const visibleItems = () => items.filter((item) => !item.hidden);

      const closeDropdown = () => {
        dropdown?.setAttribute("hidden", "");
        input?.setAttribute("aria-expanded", "false");
        input?.removeAttribute("aria-activedescendant");
        activeIndex = -1;
        items.forEach((item) => item.setAttribute("aria-selected", "false"));
      };

      const setActiveItem = (index) => {
        const visible = visibleItems();
        items.forEach((item) => item.setAttribute("aria-selected", "false"));

        if (!visible.length) {
          activeIndex = -1;
          input?.removeAttribute("aria-activedescendant");
          return;
        }

        activeIndex = ((index % visible.length) + visible.length) % visible.length;
        const active = visible[activeIndex];
        active?.setAttribute("aria-selected", "true");
        if (active?.id) {
          input?.setAttribute("aria-activedescendant", active.id);
        }
        active?.scrollIntoView({ block: "nearest" });
      };

      const filterResources = () => {
        const query = (input?.value ?? "").trim().toLowerCase();

        if (!query) {
          items.forEach((item) => {
            item.hidden = true;
          });
          empty?.setAttribute("hidden", "");
          if (status) status.textContent = "";
          closeDropdown();
          return;
        }

        let matchCount = 0;
        items.forEach((item) => {
          const haystack = (item.dataset.search ?? "").toLowerCase();
          const matches = haystack.includes(query);
          item.hidden = !matches;
          if (matches) matchCount += 1;
        });

        dropdown?.removeAttribute("hidden");
        input?.setAttribute("aria-expanded", "true");
        empty?.toggleAttribute("hidden", matchCount > 0);
        if (status) {
          status.textContent =
            matchCount === 1 ? "1 resource found" : `${matchCount} resources found`;
        }
        setActiveItem(matchCount > 0 ? 0 : -1);
      };

      input?.addEventListener("input", filterResources);
      input?.addEventListener("keydown", (event) => {
        const visible = visibleItems();

        if (event.key === "ArrowDown" && visible.length) {
          event.preventDefault();
          setActiveItem(activeIndex + 1);
        }

        if (event.key === "ArrowUp" && visible.length) {
          event.preventDefault();
          setActiveItem(activeIndex - 1);
        }

        if (event.key === "Enter" && visible[activeIndex]) {
          event.preventDefault();
          visible[activeIndex].querySelector("a")?.click();
        }

        if (event.key === "Escape") {
          input.value = "";
          closeDropdown();
        }
      });

      items.forEach((item) => {
        item.addEventListener("mouseenter", () => {
          const index = visibleItems().indexOf(item);
          if (index >= 0) setActiveItem(index);
        });
      });

      document.addEventListener("click", (event) => {
        if (!resourceSearchRoot.contains(event.target)) {
          closeDropdown();
        }
      });

      document.addEventListener("keydown", (event) => {
        const activeElement = document.activeElement;
        const isTyping =
          activeElement?.matches?.("input, textarea, select, [contenteditable='true']");

        if (event.key === "/" && !isTyping) {
          event.preventDefault();
          input?.focus();
        }
      });
    }
  </script>

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
