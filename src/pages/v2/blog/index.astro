---
import SanctuaryFooter from "../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../layouts/SanctuaryLayout.astro";
import { getBlogPostsByLang } from "../../../lib/collections";
import { formatDate } from "../../../lib/format-date";
import { slugifyCategory, v2BlogCategoryMeta } from "../../../lib/v2ContentMeta";

const posts = await getBlogPostsByLang("en");
const featuredEntry = posts[0];
const secondaryEntries = posts.slice(1, 3);
const archiveEntries = posts.slice(3);
const sampleCount = posts.filter((post) => post.data.isSample).length;
const latestDate = featuredEntry ? formatDate(featuredEntry.data.date) : "Pending";

const categories = [...new Set(posts.map((post) => post.data.category))]
  .sort()
  .map((category) => ({
    name: category,
    count: posts.filter((post) => post.data.category === category).length,
    description:
      v2BlogCategoryMeta[category]?.description ?? `Posts filed under ${category}.`,
    href: `/v2/blog/category/${slugifyCategory(category)}/`,
    icon: v2BlogCategoryMeta[category]?.icon ?? "fa-solid fa-folder-open",
  }));
---

<SanctuaryLayout
  title="Blog - Jason Holt Digital"
  description="Release notes, build notes, and behind-the-scenes writing from Jason Holt Digital."
  canonicalPath="/v2/blog/"
  mainClass="sx-blog-main"
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
      title="Jason Holt Digital Blog"
    />
  </Fragment>

  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" aria-labelledby="blog-hero-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">Field notes from the Mythic table</p>
        <h1 id="blog-hero-title" class="sx-page-title">Blog <em>dispatches</em></h1>
        <p class="sx-page-lead">
          Release notes first, then process notes, community signals, and the
          occasional life update from the workbench.
        </p>
        <div class="sx-cta-row" aria-label="Blog actions">
          <a class="sx-btn sx-btn--primary" href="/rss.xml">
            <i class="fa-solid fa-rss" aria-hidden="true"></i>
            RSS feed
          </a>
          <a class="sx-btn sx-btn--ghost" href="/v2/blog/#blog-topics-title">
            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            Browse topics
          </a>
        </div>
      </div>
      <aside class="sx-card" aria-label="Blog archive summary">
        <h3>Archive ledger</h3>
        <p>Posts: {posts.length}</p>
        <p>Latest: {latestDate}</p>
        <p>Topics: {categories.length}</p>
        {sampleCount > 0 && <p>Samples: {sampleCount}</p>}
      </aside>
    </div>
  </section>

  {
    featuredEntry ? (
      <section class="sx-section sx-section--band" aria-labelledby="blog-feature-title">
        <div class="sx-wrap">
          <p class="sx-kicker" aria-hidden="true">Latest</p>
          <div class="sx-proof" style="margin-bottom:0.75rem;">
            <span>{featuredEntry.data.category}</span>
            <span>{formatDate(featuredEntry.data.date)}</span>
            <span>{featuredEntry.data.readTime}</span>
            {featuredEntry.data.isSample && <span class="sx-badge">Sample</span>}
          </div>
          <h2 id="blog-feature-title" class="sx-sec-title">
            <a href={`/v2/blog/${featuredEntry.id}/`}>{featuredEntry.data.title}</a>
          </h2>
          <p class="sx-page-lead">{featuredEntry.data.summary}</p>
          <div class="sx-cta-row" style="margin-top:1rem;">
            <a class="sx-btn sx-btn--primary" href={`/v2/blog/${featuredEntry.id}/`}>
              Read the latest dispatch
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </section>
    ) : (
      <section class="sx-section" aria-labelledby="blog-feature-title">
        <div class="sx-wrap">
          <p class="sx-kicker" aria-hidden="true">Archive pending</p>
          <h2 id="blog-feature-title" class="sx-sec-title">Blog posts are coming soon.</h2>
          <p class="sx-page-lead">Add English posts to the blog collection to populate this page.</p>
        </div>
      </section>
    )
  }

  {
    secondaryEntries.length > 0 && (
      <section class="sx-section" aria-labelledby="blog-broadsheet-title">
        <div class="sx-wrap">
          <p class="sx-kicker" aria-hidden="true">On the desk</p>
          <h2 id="blog-broadsheet-title" class="sx-sec-title">
            Recent writing with the ink still drying.
          </h2>
          <ul class="sx-card-grid" style="margin-top:1.5rem;">
            {secondaryEntries.map((entry) => (
              <li class="sx-card">
                <div class="sx-proof" style="margin-bottom:0.5rem;">
                  <span>{entry.data.category}</span>
                  <span>{formatDate(entry.data.date)}</span>
                  {entry.data.isSample && <span class="sx-badge">Sample</span>}
                </div>
                <h3>
                  <a href={`/v2/blog/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="sx-section sx-section--band" aria-labelledby="blog-archive-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Archive stream</p>
      <h2 id="blog-archive-title" class="sx-sec-title">The running record.</h2>
      <p class="sx-page-lead">
        Chronological release notes and longer notes stay together here so
        players can trace how the apps have changed over time.
      </p>
      <ul class="sx-list" style="margin-top:1.5rem;">
        {
          archiveEntries.map((entry) => (
            <li>
              <a href={`/v2/blog/${entry.id}/`}>
                <strong>{entry.data.title}</strong>
                {entry.data.isSample && <> <span class="sx-badge">Sample</span></>}
                <span class="sx-list__meta">
                  {entry.data.category} · {formatDate(entry.data.date)} · {entry.data.readTime}
                </span>
                <span class="sx-list__meta">{entry.data.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="sx-section" aria-labelledby="blog-topics-title">
        <div class="sx-wrap">
          <p class="sx-kicker" aria-hidden="true">Browse by topic</p>
          <h2 id="blog-topics-title" class="sx-sec-title">Find the right shelf.</h2>
          <nav class="sx-card-grid" aria-label="Blog categories" style="margin-top:1.5rem;">
            {categories.map((category) => (
              <a class="sx-card" href={category.href}>
                <h3>
                  <i class={category.icon} aria-hidden="true"></i> {category.name}
                </h3>
                <p>{category.description}</p>
                <p><strong>{category.count}</strong></p>
              </a>
            ))}
          </nav>
        </div>
      </section>
    )
  }

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
