---
import { getCollection, type CollectionEntry } from "astro:content";
import SanctuaryFooter from "../../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../../layouts/SanctuaryLayout.astro";
import { formatDate } from "../../../../lib/format-date";
import {
  slugifyCategory,
  v2BlogCategoryMeta,
  type V2BlogCategoryName,
} from "../../../../lib/v2ContentMeta";

type BlogEntry = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return data.lang === "en" || data.lang === undefined;
  });
  const uniqueCategories = [
    ...new Set<V2BlogCategoryName>(posts.map((post) => post.data.category)),
  ];

  return uniqueCategories.map((category) => ({
    params: { category: slugifyCategory(category) },
    props: { originalCategory: category },
  }));
}

const { category } = Astro.params as { category: string };
const { originalCategory } = Astro.props as {
  originalCategory: V2BlogCategoryName;
};

const allPosts = await getCollection("blog", ({ data }) => {
  return data.lang === "en" || data.lang === undefined;
});
const categoryCounts = allPosts.reduce((counts, post) => {
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
  return counts;
}, new Map<V2BlogCategoryName, number>());
const categoryPosts = allPosts
  .filter((post: BlogEntry) => post.data.category === originalCategory)
  .sort((a: BlogEntry, b: BlogEntry) => b.data.date.getTime() - a.data.date.getTime());

const currentMeta = v2BlogCategoryMeta[originalCategory];
const otherCategories = Object.entries(v2BlogCategoryMeta).filter(
  ([name]) => name !== originalCategory && categoryCounts.has(name as V2BlogCategoryName),
);
const canonicalPath = `/v2/blog/category/${category}/`;
---

<SanctuaryLayout
  title={`${originalCategory} - Jason Holt Digital Blog`}
  description={currentMeta.description}
  canonicalPath={canonicalPath}
  mainClass="sx-detail-main"
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
      title="Jason Holt Digital Blog"
    />
  </Fragment>

  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" aria-labelledby="category-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">Topic shelf</p>
        <h1 id="category-title" class="sx-page-title">{originalCategory}</h1>
        <p class="sx-page-lead">{currentMeta.description}</p>
        <ul class="sx-proof" aria-label="Category details">
          <li>
            {categoryPosts.length} {categoryPosts.length === 1 ? "post" : "posts"}
          </li>
          <li><a href="/rss.xml">RSS available</a></li>
        </ul>
      </div>
      <aside class="sx-card">
        <h3>Browse by topic</h3>
        <p>Release notes, guides, process notes, community updates, and announcements stay on their own shelves.</p>
      </aside>
    </div>
  </section>

  <section class="sx-section" aria-labelledby="category-posts-title">
    <div class="sx-wrap">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;align-items:end;margin-bottom:1.25rem;">
        <div>
          <p class="sx-kicker" aria-hidden="true">{originalCategory}</p>
          <h2 id="category-posts-title" class="sx-sec-title">Posts on this shelf.</h2>
        </div>
        <a class="sx-btn sx-btn--ghost" href="/v2/blog/">Back to all posts</a>
      </div>
      <ol class="sx-list">
        {categoryPosts.map((entry) => (
          <li>
            <a href={`/v2/blog/${entry.id}/`}>
              <strong>{entry.data.title}</strong>
              {entry.data.isSample && <> <span class="sx-badge">Sample</span></>}
              <span class="sx-list__meta">{entry.data.summary}</span>
              <span class="sx-list__meta">{formatDate(entry.data.date)}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {otherCategories.length > 0 && (
    <section class="sx-section sx-section--band" aria-labelledby="other-categories-title">
      <div class="sx-wrap">
        <p class="sx-kicker" aria-hidden="true">Browse</p>
        <h2 id="other-categories-title" class="sx-sec-title">Other shelves.</h2>
        <ul class="sx-card-grid" style="margin-top:1.5rem;">
          {otherCategories.map(([name, meta]) => (
            <li>
              <a class="sx-card" href={`/v2/blog/category/${slugifyCategory(name)}/`}>
                <h3>
                  <i class={meta.icon} aria-hidden="true"></i> {name}
                </h3>
                <p>{meta.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
