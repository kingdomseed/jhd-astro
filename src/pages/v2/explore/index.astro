---
/**
 * Sanctuary explore — hydroponics-inspired landing adapted for Mythic GME.
 *
 * Image placement (verified dims + orientation before use):
 * - Hero frame: art-3.png (1700×2200 portrait) — introspective figures
 * - Hero cutout: stamp-astronaut.png (1784×1237 landscape) — contemplative suit
 * - Pillar Fate: stamp-art10.png (1784×2284 portrait) — Random Events plate
 * - Pillar Guides: stamp-art15.png (1634×1825 portrait) — forest explorers
 * - Pillar Scenes: stamp-art20.png (1784×2284 portrait) — interrupt encounter
 * - Journey band: stamp-wastelander.png (1484×687 landscape) — wide only
 * - Phone strip: mobile-1/2/4.png (1419×2796 portrait device shots)
 */
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sanctuary Explore — Jason Holt Digital</title>
    <meta
      name="description"
      content="Design exploration: a Muñoz-forward sanctuary landing for the official Mythic GME apps hub."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://jasonholtdigital.com/v2/explore/" />
    <link rel="icon" href="/v2/assets/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/v2/explore/sanctuary.css" />
  </head>
  <body class="sx">
    <a class="sx-skip" href="#main">Skip to main content</a>

    <header class="sx-nav">
      <div class="sx-wrap sx-nav__row">
        <a class="sx-brand" href="/v2/explore/">
          <span class="sx-brand__mark">
            <img src="/v2/assets/logo-munoz.svg" alt="" width="44" height="44" />
          </span>
          <span class="sx-brand__text">
            <span class="sx-brand__name">Jason Holt Digital</span>
            <span class="sx-brand__sub">Official Mythic GME Apps</span>
          </span>
        </a>

        <nav class="sx-nav__links" aria-label="Primary">
          <a href="/v2/">Current V2</a>
          <a href="/v2/explore/" aria-current="page">Explore</a>
          <a href="/v2/#apps">Apps</a>
          <a href="/v2/resources/">Resources</a>
          <a href="/v2/about/">About</a>
        </nav>

        <a class="sx-nav__cta" href="/v2/support/#contact-panel">
          Contact Us <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>

        <button
          class="sx-burger"
          type="button"
          data-sx-open
          aria-expanded="false"
          aria-controls="sxDrawer"
          aria-label="Open menu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="sx-drawer-overlay" data-sx-overlay hidden></div>
    <aside class="sx-drawer" id="sxDrawer" data-sx-drawer hidden aria-hidden="true">
      <button class="sx-drawer__close" type="button" data-sx-close aria-label="Close menu">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <nav aria-label="Mobile">
        <a href="/v2/">Current V2</a>
        <a href="/v2/explore/">Explore</a>
        <a href="/v2/#apps">Apps</a>
        <a href="/v2/resources/">Resources</a>
        <a href="/v2/about/">About</a>
        <a href="/v2/support/#contact-panel">Contact</a>
      </nav>
    </aside>

    <main id="main">
      <section class="sx-hero" aria-labelledby="sx-hero-title">
        <div class="sx-wrap sx-hero__grid">
          <div class="sx-hero__copy">
            <p class="sx-kicker" aria-hidden="true">Fate · Story · Imagination</p>
            <h1 id="sx-hero-title" class="sx-hero__title">
              GM-less play at <em>your fingertips</em>.
            </h1>
            <p class="sx-hero__lead">
              Official Mythic GME companion apps for mobile and desktop. Ask Fate Questions,
              roll Meaning Tables, and keep scenes, threads, and characters close to the story.
            </p>
            <div class="sx-cta-row">
              <a class="sx-btn sx-btn--primary" href="/v2/#apps">
                See the Apps <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
              <a class="sx-btn sx-btn--ghost" href="/v2/resources/">
                <i class="fa-solid fa-book-open" aria-hidden="true"></i> Get Resources
              </a>
            </div>
            <ul class="sx-proof">
              <li><i class="fa-solid fa-star" aria-hidden="true"></i> 4.8 App Store rating</li>
              <li><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i> Mobile + desktop</li>
              <li><i class="fa-solid fa-unlock" aria-hidden="true"></i> No subscriptions</li>
            </ul>
          </div>

          <div class="sx-stage" aria-hidden="true">
            <div class="sx-stage__glow"></div>
            <div class="sx-stage__orbit"></div>
            <!-- Portrait 1700×2200: framed gallery hero -->
            <figure class="sx-stage__frame">
              <div class="sx-stage__media">
                <img
                  src="/v2/assets/art-3.png"
                  alt=""
                  width="1700"
                  height="2200"
                  fetchpriority="high"
                />
              </div>
              <figcaption class="sx-stage__caption">
                <span>Rooted in Wonder</span>
                <span>Jorge Muñoz</span>
              </figcaption>
            </figure>
            <!-- Landscape 1784×1237: layered cutout, not forced into portrait frame -->
            <div class="sx-stage__cutout">
              <img
                src="/v2/assets/stamp-astronaut.png"
                alt=""
                width="1784"
                height="1237"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="sx-pillars" aria-labelledby="sx-pillars-title">
        <div class="sx-wrap">
          <div class="sx-section-head">
            <div>
              <p class="sx-kicker" aria-hidden="true">Explore the collection</p>
              <h2 id="sx-pillars-title">Three doors into Mythic play</h2>
            </div>
            <p>
              Clean structure for the work of play, paired with linocut-forward Muñoz art that
              keeps the hub feeling human instead of clinical.
            </p>
          </div>

          <div class="sx-pillar-grid">
            <article class="sx-pillar">
              <!-- Portrait 1784×2284 — Random Events plate -->
              <div class="sx-pillar__media sx-pillar__media--events">
                <img
                  src="/v2/assets/stamp-art10.png"
                  alt=""
                  width="1784"
                  height="2284"
                  loading="lazy"
                />
              </div>
              <div>
                <p class="sx-pillar__cat">Oracle tools</p>
                <h3>Fate Questions</h3>
                <p>
                  Ask yes/no questions, roll the Fate Chart, and stay close to what happens next
                  without breaking the rhythm of a session.
                </p>
                <a class="sx-pillar__link" href="/v2/#apps">
                  View apps <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>

            <article class="sx-pillar">
              <!-- Portrait 1634×1825 — explorers / journey -->
              <div class="sx-pillar__media sx-pillar__media--journey">
                <img
                  src="/v2/assets/stamp-art15.png"
                  alt=""
                  width="1634"
                  height="1825"
                  loading="lazy"
                />
              </div>
              <div>
                <p class="sx-pillar__cat">Guides for play</p>
                <h3>Resources</h3>
                <p>
                  Practical guides for Journals, dice formulas, Custom Tables, and getting
                  comfortable with Mythic in play.
                </p>
                <a class="sx-pillar__link" href="/v2/resources/">
                  Get resources <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>

            <article class="sx-pillar">
              <!-- Portrait 1784×2284 — interrupt / scene pressure -->
              <div class="sx-pillar__media sx-pillar__media--interrupt">
                <img
                  src="/v2/assets/stamp-art20.png"
                  alt=""
                  width="1784"
                  height="2284"
                  loading="lazy"
                />
              </div>
              <div>
                <p class="sx-pillar__cat">Scenes &amp; lists</p>
                <h3>Keep play moving</h3>
                <p>
                  Track scenes, threads, and characters in one place so bookkeeping stays out of
                  the way when the story turns.
                </p>
                <a class="sx-pillar__link" href="/v2/support/">
                  Support &amp; FAQ <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="sx-band" aria-labelledby="sx-band-title">
        <div class="sx-wrap">
          <div class="sx-band__panel">
            <div class="sx-band__copy">
              <p class="sx-kicker" aria-hidden="true">Mobile + desktop</p>
              <h2 id="sx-band-title">A playspace that travels with you</h2>
              <p>
                Mythic GME Mobile fits in a pocket. Mythic GME Digital gives Windows, macOS, and
                Linux players more room for longer sessions. Same Mythic flow, different surfaces.
              </p>
              <div class="sx-cta-row">
                <a class="sx-btn sx-btn--primary" href="/v2/#apps">Compare the apps</a>
              </div>
            </div>
            <!-- Landscape 1484×687 — wide band only, never cropped into portrait cards -->
            <div class="sx-band__media">
              <img
                src="/v2/assets/stamp-wastelander.png"
                alt=""
                width="1484"
                height="687"
                loading="lazy"
              />
              <span class="sx-band__tag">Landscape art · Muñoz</span>
            </div>
          </div>
        </div>
      </section>

      <section class="sx-apps" aria-labelledby="sx-apps-title">
        <div class="sx-wrap sx-apps__grid">
          <div class="sx-apps__copy">
            <p class="sx-kicker" aria-hidden="true">In the apps</p>
            <h2 id="sx-apps-title">Fate, scenes, and dice where you need them</h2>
            <p>
              Portrait device shots stay in portrait frames. The sanctuary shell keeps the UI
              calm while Muñoz art carries the emotional weight around it.
            </p>
            <a class="sx-btn sx-btn--ghost" href="/v2/#apps">
              See the Apps <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
          <div class="sx-phone-row">
            <figure class="sx-phone">
              <div class="sx-phone__media">
                <img
                  src="/v2/assets/mobile-1.png"
                  alt="Fate Chart screen in Mythic GME Mobile"
                  width="1419"
                  height="2796"
                  loading="lazy"
                />
              </div>
              <figcaption>Fate Chart</figcaption>
            </figure>
            <figure class="sx-phone">
              <div class="sx-phone__media">
                <img
                  src="/v2/assets/mobile-2.png"
                  alt="Scenes screen in Mythic GME Mobile"
                  width="1419"
                  height="2796"
                  loading="lazy"
                />
              </div>
              <figcaption>Scenes</figcaption>
            </figure>
            <figure class="sx-phone">
              <div class="sx-phone__media">
                <img
                  src="/v2/assets/mobile-4.png"
                  alt="Dice roller screen in Mythic GME Mobile"
                  width="1419"
                  height="2796"
                  loading="lazy"
                />
              </div>
              <figcaption>Dice</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="sx-quote" aria-label="Founding note">
        <div class="sx-wrap sx-quote__panel">
          <div>
            <div class="sx-quote__mark" aria-hidden="true">“</div>
            <blockquote>
              I want the apps to make Mythic feel ready to play in one place, without pulling
              attention away from the story.
            </blockquote>
          </div>
          <ul class="sx-quote__values">
            <li>Curiosity</li>
            <li>Clarity</li>
            <li>Care</li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="sx-foot">
      <div class="sx-wrap">
        <div class="sx-foot__row">
          <p class="sx-foot__meta">
            © {year} Jason Holt Digital · Official Mythic GME 2e Apps<br />
            Sanctuary design exploration — not production.
          </p>
          <nav class="sx-foot__links" aria-label="Footer">
            <a href="/v2/">Current V2</a>
            <a href="/v2/support/#contact-panel">Contact</a>
            <a href="/v2/privacy/">Privacy</a>
            <a href="/v2/terms/">Terms</a>
          </nav>
        </div>
        <p class="sx-foot__note">
          Adapted from the Artisan Hydroponics sanctuary references and Jorge Muñoz art already
          in this repo. Portrait art stays in portrait frames; landscape art stays in wide bands.
          Production copy rules from CONTEXT.md are preserved.
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var openBtn = document.querySelector("[data-sx-open]");
        var closeBtn = document.querySelector("[data-sx-close]");
        var drawer = document.querySelector("[data-sx-drawer]");
        var overlay = document.querySelector("[data-sx-overlay]");
        if (!openBtn || !closeBtn || !drawer || !overlay) return;

        function setOpen(open) {
          drawer.classList.toggle("is-open", open);
          overlay.classList.toggle("is-open", open);
          drawer.hidden = !open;
          overlay.hidden = !open;
          drawer.setAttribute("aria-hidden", open ? "false" : "true");
          openBtn.setAttribute("aria-expanded", open ? "true" : "false");
          document.body.classList.toggle("has-sx-nav-open", open);
          if (open) closeBtn.focus();
          else openBtn.focus();
        }

        openBtn.addEventListener("click", function () {
          setOpen(true);
        });
        closeBtn.addEventListener("click", function () {
          setOpen(false);
        });
        overlay.addEventListener("click", function () {
          setOpen(false);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && drawer.classList.contains("is-open")) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
