---
import { getEntry } from "astro:content";
import SanctuaryFooter from "../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../layouts/SanctuaryLayout.astro";
import { v2ContactUrl, v2DiscordUrl } from "../../../lib/v2Links";

const aboutEntry = await getEntry("pages", "about");
if (!aboutEntry) throw new Error("Could not find about entry in pages collection");

const {
  title,
  subtitle,
  description,
  backgroundHighlights = [],
  mythicHighlights = [],
} = aboutEntry.data;
---

<SanctuaryLayout
  title={`About - ${title}`}
  description={description}
  canonicalPath="/v2/about/"
  mainClass="sx-about-main"
>
  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" aria-labelledby="about-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">{subtitle}</p>
        <h1 id="about-title" class="sx-page-title">Hi, I'm <em>Jason</em>.</h1>
        <p class="sx-page-lead">{description}</p>
        <ul class="sx-proof" aria-label="About highlights">
          <li>Licensed with Word Mill Games</li>
          <li>Indie developer</li>
          <li>Computational linguistics student</li>
        </ul>
      </div>
      <figure class="sx-media sx-media--portrait">
        <img src="/v2/assets/jason.jpg" alt="Jason Holt" loading="eager" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="sx-section" aria-labelledby="about-overview-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Profile</p>
      <h2 id="about-overview-title" class="sx-sec-title">I build tools for play that stays in motion.</h2>
      <div class="sx-prose">
        <p>I wrote my first program at twelve: a Redwall choose-your-own-adventure in Basic. Then nine years of teaching computer science, some Flutter experiments, and finally building a real app after dreaming about it since I ran Hour of Code with my students in 2013.</p>
        <p>I maintain two products under license from Word Mill Games: <strong>Mythic GME Mobile</strong> for iOS and Android, and <strong>Mythic GME Digital</strong> for Windows, macOS, and Linux.</p>
        <p>I'm also pursuing an M.Sc. in Computational Linguistics: part curiosity about how language and software can work together for solo play, and part the same pattern that has driven every fresh start in my career. Someone had a need, and I wanted to help meet it.</p>
      </div>
    </div>
  </section>

  <section class="sx-section sx-section--band" aria-labelledby="about-mythic-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Official</p>
      <h2 id="about-mythic-title" class="sx-sec-title">Licensed Mythic apps, shaped with the community.</h2>
      <p class="sx-page-lead">Less flipping through tables, more time in the story.</p>
      <ul class="sx-card-grid" style="margin-top: 1.5rem;">
        {mythicHighlights.map((item) => (
          <li class="sx-card">
            <h3>{item.label}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sx-section" aria-labelledby="about-approach-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Approach</p>
      <h2 id="about-approach-title" class="sx-sec-title">Small, frequent updates. Real support conversations.</h2>
      <p class="sx-page-lead">The work improves because players keep telling me where the table gets stuck.</p>
      <ul class="sx-card-grid" style="margin-top: 1.5rem;">
        {backgroundHighlights.map((item) => (
          <li class="sx-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sx-section sx-section--band" aria-labelledby="about-connect-title">
    <div class="sx-wrap">
      <p class="sx-kicker" aria-hidden="true">Connect</p>
      <h2 id="about-connect-title" class="sx-sec-title">I read every message.</h2>
      <p class="sx-page-lead">Bug reports, feature ideas, or a story about your last session: send it over.</p>
      <div class="sx-cta-row" style="margin-top: 1.25rem;">
        <a class="sx-btn sx-btn--primary" href={v2ContactUrl}>
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          Contact
        </a>
        <a class="sx-btn sx-btn--accent" href={v2DiscordUrl} target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-discord" aria-hidden="true"></i>
          Discord
        </a>
      </div>
    </div>
  </section>

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
