---
import { getEntry } from "astro:content";
import V2RefinedFooter from "../../../components/v2/refined/V2RefinedFooter.astro";
import V2RefinedHeader from "../../../components/v2/refined/V2RefinedHeader.astro";
import V2RefinedTweaksPanel from "../../../components/v2/refined/V2RefinedTweaksPanel.astro";
import V2RefinedUtilBar from "../../../components/v2/refined/V2RefinedUtilBar.astro";
import V2RefinedLayout from "../../../layouts/V2RefinedLayout.astro";
import { v2ContactUrl, v2DiscordUrl } from "../../../lib/v2Links";

const aboutEntry = await getEntry("pages", "about");
if (!aboutEntry) throw new Error("Could not find about entry in pages collection");

const {
  title,
  description,
} = aboutEntry.data;

const productHighlights = [
  {
    label: "Fate Questions",
    description:
      "Answer Fate Questions with the Fate Chart or a streamlined Fate Check.",
  },
  {
    label: "Adventure Log",
    description:
      "Keep scenes, Characters, Threads, Features, and play notes together.",
  },
  {
    label: "Custom Tables",
    description:
      "Create, import, link, and export rollable tables for the way you play.",
  },
  {
    label: "Dice formulas",
    description: "Save the rolls you use most and keep them close during play.",
  },
];

const approachHighlights = [
  {
    icon: "fa-solid fa-comments",
    title: "Support conversations",
    description:
      "Players tell me when something saves time, gets confusing, or slows down real play.",
  },
  {
    icon: "fa-solid fa-list-check",
    title: "Feature request trail",
    description:
      "Discord, email, and the feature board help show what is being considered, planned, fixed, or improved.",
  },
  {
    icon: "fa-solid fa-code-branch",
    title: "Product judgment",
    description:
      "Sometimes the answer is a quick fix. Sometimes it is a design change. Sometimes I need to think about it more.",
  },
];
---

<V2RefinedLayout
  title={`About - ${title}`}
  description={description}
  canonicalPath="/v2/about/"
  mainClass="v2-about-main"
  theme="munoz"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/v2/assets/detail.css" />
  </Fragment>

  <V2RefinedUtilBar slot="before-main" />
  <V2RefinedHeader slot="before-main" />

  <section class="v2-page-hero" aria-labelledby="about-title">
    <div class="wrap v2-page-hero__grid">
      <div class="v2-page-hero__copy">
        <p class="eyebrow"><span class="eyebrow-num">01</span>About</p>
        <h1 id="about-title" class="v2-page-title">About <em>Jason</em>.</h1>
        <p class="v2-page-lead">{description}</p>
        <ul class="v2-page-meta" aria-label="About highlights">
          <li class="v2-page-pill">Word Mill Creative partner</li>
          <li class="v2-page-pill">Mythic app builder</li>
          <li class="v2-page-pill">Player feedback loop</li>
        </ul>
      </div>
      <figure class="v2-page-card">
        <img src="/v2/assets/jason.jpg" alt="Jason Holt" loading="eager" decoding="async" />
        <figcaption>
          <strong>{title}</strong>
          <span>Official Mythic GME apps, kept close to players.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="v2-section" aria-labelledby="about-overview-title">
    <div class="wrap v2-split">
      <div>
        <p class="eyebrow"><span class="eyebrow-num">02</span>Profile</p>
        <h2 id="about-overview-title" class="sec-title">How I got here</h2>
      </div>
      <div class="v2-prose">
        <p>My brother and I grew up playing games of imagination, creating characters from our heads and from Legos, and sending them through whatever worlds we could dream up.</p>
        <p>When I was twelve, I got hold of an old laptop with a black-and-white screen. It could not do much, but it had BASIC, and I found an old high school textbook that taught me how to use it.</p>
        <p>The first program I made was a game. I was reading Redwall constantly then, so I built a little choose-your-own-adventure in BASIC.</p>
        <p>Years later, after I moved to Germany and was figuring out what came after teaching, I started setting up a small software business. I was looking at practical work like Shopify development, but I still wanted to build apps.</p>
        <p>My brother was more plugged into the TTRPG community, and he knew I still wanted to build apps. He sent me a note that Tana Pigeon was looking for someone to build an app for Mythic.</p>
        <p>I had not heard of Mythic before, and I was cautious about getting too excited. The more I looked into it, the more I could see why players cared about it.</p>
        <p>Mythic felt connected to the kind of play I had always loved. You make a character, explore a world, and find out what happens next. I wanted the app to help with the parts that slow play down, feel good to use, and stay quiet enough to get out of the way while people tell their stories.</p>
        <p>Today I build and maintain two officially licensed Mythic GME 2e apps. <strong>Mythic GME Mobile</strong> runs on iOS and Android. <strong>Mythic GME Digital</strong> runs on Windows, macOS, and Linux.</p>
        <p>I am still working on the apps, improving them, planning what comes next, supporting players, and listening to feedback while I finish my M.Sc. in Computational Linguistics.</p>
      </div>
    </div>
  </section>

  <section class="v2-section v2-section--ink" aria-labelledby="about-mythic-title">
    <div class="wrap v2-split">
      <div>
        <p class="eyebrow"><span class="eyebrow-num">03</span>Official</p>
        <h2 id="about-mythic-title" class="sec-title">Licensed Mythic apps that stay close to play.</h2>
        <p class="sec-sub">Less lookup, more time in the story.</p>
      </div>
      <ul class="v2-grid-list">
        {productHighlights.map((item) => (
          <li class="v2-grid-card">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <h3>{item.label}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v2-section" aria-labelledby="about-approach-title">
    <div class="wrap v2-split">
      <div>
        <p class="eyebrow"><span class="eyebrow-num">04</span>Approach</p>
        <h2 id="about-approach-title" class="sec-title">Small, frequent updates. Real support conversations.</h2>
        <p class="sec-sub">The work improves because players keep telling me where the table gets stuck.</p>
      </div>
      <ul class="v2-grid-list">
        {approachHighlights.map((item) => (
          <li class="v2-grid-card">
            <i class={item.icon} aria-hidden="true"></i>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v2-section v2-section--ink" aria-labelledby="about-connect-title">
    <div class="wrap v2-split">
      <div>
        <p class="eyebrow"><span class="eyebrow-num">05</span>Connect</p>
        <h2 id="about-connect-title" class="sec-title">I read every message.</h2>
        <p class="sec-sub">Send a bug report, a feature idea, a question, or a story about what happened in your last session.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn--primary btn--lg" href={v2ContactUrl}>
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          Contact
        </a>
        <a class="btn btn--accent btn--lg" href={v2DiscordUrl} target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-discord" aria-hidden="true"></i>
          Discord
        </a>
      </div>
    </div>
  </section>

  <V2RefinedFooter slot="after-main" />
  <V2RefinedTweaksPanel slot="after-main" />
</V2RefinedLayout>
