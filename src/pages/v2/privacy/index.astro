---
import SanctuaryFooter from "../../../components/v2/sanctuary/SanctuaryFooter.astro";
import SanctuaryHeader from "../../../components/v2/sanctuary/SanctuaryHeader.astro";
import SanctuaryLayout from "../../../layouts/SanctuaryLayout.astro";
import { extractLegalArticle } from "../../../lib/v2Legal";
import privacySource from "../../privacy.astro?raw";

const legalArticle = extractLegalArticle(privacySource, "privacy.astro");
---

<SanctuaryLayout
  title="Privacy Policy - Jason Holt Digital"
  description="Learn how Mythic GME Apps handles privacy: minimal data collection, local-first storage, optional analytics, and clear controls."
  canonicalPath="/v2/privacy/"
  mainClass="sx-legal-main"
>
  <SanctuaryHeader slot="before-main" />

  <section class="sx-page-hero" aria-labelledby="privacy-title">
    <div class="sx-wrap sx-page-hero__grid">
      <div>
        <p class="sx-kicker" aria-hidden="true">Privacy</p>
        <h1 id="privacy-title" class="sx-page-title">Privacy <em>Policy</em>.</h1>
        <p class="sx-page-lead">
          Minimal data collection, local-first storage, and clear controls.
          Last updated: August 27, 2025.
        </p>
        <ul class="sx-proof" aria-label="Privacy highlights">
          <li>Analytics opt-in</li>
          <li>Local-first game data</li>
          <li>No data sales</li>
        </ul>
      </div>
      <aside class="sx-card">
        <h3>Plain promise</h3>
        <p>I built these apps for the community. Your game content stays yours.</p>
      </aside>
    </div>
  </section>

  <section class="sx-article">
    <div class="sx-wrap" style="display:grid;grid-template-columns:1.4fr 0.6fr;gap:1.5rem;align-items:start;">
      <article class="sx-article__body" set:html={legalArticle} />
      <aside aria-label="Privacy actions">
        <div class="sx-card" style="margin-bottom:1rem;">
          <h3>Privacy questions</h3>
          <p><a href="mailto:privacy@jasonholtdigital.com">privacy@jasonholtdigital.com</a></p>
        </div>
        <div class="sx-card">
          <h3>Controls</h3>
          <p>Analytics and diagnostics controls live in app settings.</p>
        </div>
      </aside>
    </div>
  </section>

  <SanctuaryFooter slot="after-main" />
</SanctuaryLayout>
